# 請複製必要值到 Hermes 的 .env；不要將真實 token 提交至版本控制。
# 為 hermes serve 設定固定的本機 backend session token。
HERMES_DASHBOARD_SESSION_TOKEN=replace-with-a-long-random-secret

# Telegram BotFather 提供的 Bot API token。
TELEGRAM_CANONICAL_BRIDGE_BOT_TOKEN=123456:replace-with-real-token

# 必須與 HERMES_DASHBOARD_SESSION_TOKEN 相同，供 bridge 連線到 /api/ws。
TELEGRAM_CANONICAL_BRIDGE_BACKEND_TOKEN=replace-with-the-same-long-random-secret
